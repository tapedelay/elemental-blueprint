// Static site: index.html served at https://elements.atasha.me
// Deploy with ./deploy.sh, which copies index.html and site/ into dist/, so
// SPEC.md, AGENTS.md, server.js and the rest are never published.
{
  "name": "elemental-blueprint",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./dist" },
  "routes": [{ "pattern": "elements.atasha.me", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false
}
